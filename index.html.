<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>InstantLead - Business Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: #0b0f17; color: #ffffff; margin: 0; padding: 20px; display: flex; justify-content: center; }
    .container { width: 100%; max-width: 480px; }
    .card { background-color: #121826; border: 1px solid #1f293d; border-radius: 12px; padding: 24px; margin-bottom: 20px; }
    h2, h3 { margin-top: 0; color: #ffffff; }
    p { color: #94a3b8; font-size: 14px; line-height: 1.5; }
    
    .tabs { display: flex; gap: 8px; margin-bottom: 20px; background: #0b0f17; padding: 4px; border-radius: 8px; }
    .tab-btn { flex: 1; padding: 10px; background: none; border: none; color: #94a3b8; font-weight: bold; cursor: pointer; border-radius: 6px; }
    .tab-btn.active { background: #1f293d; color: #ffffff; }
    
    .form-group { margin-bottom: 16px; }
    label { display: block; font-size: 11px; font-weight: 700; color: #94a3b8; margin-bottom: 6px; letter-spacing: 0.5px; }
    input, textarea { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #1f293d; background: #0b0f17; color: #ffffff; font-size: 14px; }
    input:focus, textarea:focus { outline: none; border-color: #4f46e5; }
    
    .btn { width: 100%; padding: 14px; background: #4f46e5; color: white; border: none; border-radius: 8px; font-weight: bold; font-size: 15px; cursor: pointer; }
    .btn:hover { background: #4338ca; }
    .btn-secondary { background: #1f293d; margin-top: 10px; }
    
    .lead-item { background: #0b0f17; border: 1px solid #1f293d; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
    .lead-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .lead-name { font-weight: bold; font-size: 16px; }
    .badge { padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; background: #312e81; color: #818cf8; }
    .lead-phone { color: #38bdf8; font-size: 14px; text-decoration: none; display: inline-block; margin-bottom: 6px; }
    .lead-notes { color: #94a3b8; font-size: 13px; margin: 0; }
    
    .hidden { display: none; }
    .status-msg { margin-top: 10px; font-size: 13px; text-align: center; }
  </style>
</head>
<body>

<div class="container">

  <!-- PUBLIC LEAD CAPTURE FORM -->
  <div id="view-lead-form" class="card">
    <h2>Request Immediate Callback</h2>
    <p>Leave your contact details and an available agent will reply within 15 minutes.</p>
    
    <div class="form-group">
      <label>YOUR NAME</label>
      <input type="text" id="public-name" placeholder="John Doe" />
    </div>
    <div class="form-group">
      <label>PHONE NUMBER</label>
      <input type="tel" id="public-phone" placeholder="+234 800 000 0000" />
    </div>
    <div class="form-group">
      <label>WHAT DO YOU NEED HELP WITH?</label>
      <textarea id="public-notes" rows="3" placeholder="Briefly describe what you're looking for..."></textarea>
    </div>
    <button class="btn" onclick="submitPublicLead()">Submit Request</button>
    <div id="form-status" class="status-msg"></div>
    
    <hr style="border-color: #1f293d; margin: 24px 0 16px 0;">
    <button class="btn btn-secondary" onclick="showAuth()">Business Owner Login</button>
  </div>

  <!-- AUTHENTICATION CARD (LOGIN / SIGNUP) -->
  <div id="view-auth" class="card hidden">
    <div class="tabs">
      <button id="tab-login" class="tab-btn active" onclick="switchAuthTab('login')">Log In</button>
      <button id="tab-signup" class="tab-btn" onclick="switchAuthTab('signup')">Sign Up</button>
    </div>

    <!-- LOG IN TAB -->
    <div id="form-login">
      <h3>Business Owner Portal</h3>
      <p>Log in to view incoming leads and response alerts.</p>
      <div class="form-group">
        <label>EMAIL ADDRESS</label>
        <input type="email" id="login-email" placeholder="owner@business.com" />
      </div>
      <div class="form-group">
        <label>PASSWORD</label>
        <input type="password" id="login-pass" placeholder="••••••••" />
      </div>
      <button class="btn" onclick="handleLogin()">Log In to Dashboard</button>
    </div>

    <!-- SIGN UP TAB -->
    <div id="form-signup" class="hidden">
      <h3>Create Business Account</h3>
      <p>Start receiving and managing cold leads immediately.</p>
      <div class="form-group">
        <label>EMAIL ADDRESS</label>
        <input type="email" id="signup-email" placeholder="owner@business.com" />
      </div>
      <div class="form-group">
        <label>PASSWORD</label>
        <input type="password" id="signup-pass" placeholder="••••••••" />
      </div>
      <button class="btn" onclick="handleSignUp()">Create Account</button>
    </div>

    <div id="auth-status" class="status-msg"></div>
    <button class="btn btn-secondary" onclick="showLeadForm()">← Back to Request Form</button>
  </div>

  <!-- CLIENT DASHBOARD (PROTECTED) -->
  <div id="view-dashboard" class="card hidden">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="margin: 0;">Incoming Leads</h3>
      <button class="btn btn-secondary" style="width: auto; padding: 6px 12px; margin: 0; font-size: 12px;" onclick="handleLogout()">Log Out</button>
    </div>
    <p>Incoming customer requests ready for response:</p>
    
    <div id="leads-container">
      <p style="text-align: center; padding: 20px;">Loading leads...</p>
    </div>
  </div>

</div>

<script>
  // Supabase Configuration
  const SUPABASE_URL = 'https://waatnxffylvlfqtlznzv.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_WeghbAEB6DM-UBxu9W61tw_rqHWNd-J';
  const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  // Submit Lead from Public Form
  async function submitPublicLead() {
    const name = document.getElementById('public-name').value;
    const phone = document.getElementById('public-phone').value;
    const notes = document.getElementById('public-notes').value;
    const statusDiv = document.getElementById('form-status');

    if (!name || !phone) {
      statusDiv.style.color = '#ef4444';
      statusDiv.innerText = 'Please enter your name and phone number.';
      return;
    }

    statusDiv.style.color = '#94a3b8';
    statusDiv.innerText = 'Submitting...';

    const { data, error } = await supabase
      .from('leads')
      .insert([{ name: name, phone: phone, notes: notes, status: 'New' }]);

    if (error) {
      statusDiv.style.color = '#ef4444';
      statusDiv.innerText = 'Error: ' + error.message;
    } else {
      statusDiv.style.color = '#22c55e';
      statusDiv.innerText = 'Request submitted! An agent will call you shortly.';
      document.getElementById('public-name').value = '';
      document.getElementById('public-phone').value = '';
      document.getElementById('public-notes').value = '';
    }
  }

  // Navigation Helpers
  function showAuth() {
    document.getElementById('view-lead-form').classList.add('hidden');
    document.getElementById('view-auth').classList.remove('hidden');
  }

  function showLeadForm() {
    document.getElementById('view-auth').classList.add('hidden');
    document.getElementById('view-lead-form').classList.remove('hidden');
  }

  function switchAuthTab(tab) {
    document.getElementById('auth-status').innerText = '';
    if (tab === 'login') {
      document.getElementById('tab-login').classList.add('active');
      document.getElementById('tab-signup').classList.remove('active');
      document.getElementById('form-login').classList.remove('hidden');
      document.getElementById('form-signup').classList.add('hidden');
    } else {
      document.getElementById('tab-signup').classList.add('active');
      document.getElementById('tab-login').classList.remove('active');
      document.getElementById('form-signup').classList.remove('hidden');
      document.getElementById('form-login').classList.add('hidden');
    }
  }

  // Authentication Handlers
  async function handleSignUp() {
    const email = document.getElementById('signup-email').value;
    const pass = document.getElementById('signup-pass').value;
    const status = document.getElementById('auth-status');

    status.style.color = '#94a3b8';
    status.innerText = 'Creating account...';

    const { data, error } = await supabase.auth.signUp({ email, password: pass });

    if (error) {
      status.style.color = '#ef4444';
      status.innerText = error.message;
    } else {
      status.style.color = '#22c55e';
      status.innerText = 'Account created! Logged in automatically...';
      loadDashboard();
    }
  }

  async function handleLogin() {
    const email = document.getElementById('login-email').value;
    const pass = document.getElementById('login-pass').value;
    const status = document.getElementById('auth-status');

    status.style.color = '#94a3b8';
    status.innerText = 'Logging in...';

    const { data, error } = await supabase.auth.signInWithPassword({ email, password: pass });

    if (error) {
      status.style.color = '#ef4444';
      status.innerText = error.message;
    } else {
      loadDashboard();
    }
  }

  async function handleLogout() {
    await supabase.auth.signOut();
    document.getElementById('view-dashboard').classList.add('hidden');
    showLeadForm();
  }

  // Fetch and Display Leads
  async function loadDashboard() {
    document.getElementById('view-lead-form').classList.add('hidden');
    document.getElementById('view-auth').classList.add('hidden');
    document.getElementById('view-dashboard').classList.remove('hidden');

    const container = document.getElementById('leads-container');
    container.innerHTML = '<p style="text-align: center; padding: 20px;">Loading leads...</p>';

    const { data: leads, error } = await supabase
      .from('leads')
      .select('*')
      .order('id', { ascending: false });

    if (error) {
      container.innerHTML = `<p style="color: #ef4444;">Failed to load leads: ${error.message}</p>`;
      return;
    }

    if (!leads || leads.length === 0) {
      container.innerHTML = '<p style="text-align: center; padding: 20px; color: #94a3b8;">No leads found yet.</p>';
      return;
    }

    container.innerHTML = leads.map(lead => `
      <div class="lead-item">
        <div class="lead-header">
          <span class="lead-name">${lead.name || 'Anonymous'}</span>
          <span class="badge">${lead.status || 'New'}</span>
        </div>
        <a href="tel:${lead.phone}" class="lead-phone">📞 ${lead.phone || 'No phone'}</a>
        <p class="lead-notes">${lead.notes || 'No message attached.'}</p>
      </div>
    `).join('');
  }
</script>

</body>
  </html>
      
